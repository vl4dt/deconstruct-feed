# Environment Variables

# Paddle API Configuration
PADDLE_API_KEY=your_paddle_api_key_here
PADDLE_WEBHOOK_SECRET=your_webhook_secret_here
PADDLE_VENDOR_ID=your_vendor_id_here

# Paddle Price IDs (get these from Paddle Dashboard)
PADDLE_PRICE_MONTHLY=pri_xxx_monthly
PADDLE_PRICE_ANNUAL=pri_xxx_annual
PADDLE_PRICE_LIFETIME=pri_xxx_lifetime

# Database (Vercel Postgres)
POSTGRES_URL=postgres://default:xxx@xxx.postgres.vercel-storage.com:5432/verceldb

# CORS Configuration (optional - for production, use extension ID)
ALLOWED_ORIGINS=chrome-extension://your-extension-id
