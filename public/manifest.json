{
  "manifest_version": 3,
  "name": "NewsLens AI",
  "version": "1.0.0",
  "description": "Curate news, analyze bias, summarize articles, and create content scripts with local Chrome AI & Gemini.",
  "permissions": [
    "storage",
    "activeTab",
    "sidePanel",
    "alarms",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/logo_16.png",
      "48": "icons/logo_48.png",
      "128": "icons/logo_128.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16": "icons/logo_16.png",
    "48": "icons/logo_48.png",
    "128": "icons/logo_128.png"
  }
}